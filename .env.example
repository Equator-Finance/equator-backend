# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connections
DATABASE_URL="postgresql://equator:equatorpass@localhost:5432/equator_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Stellar / Soroban RPC Settings
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed EquatorEscrowContract ID (from `soroban contract deploy` in equator-contracts)
ESCROW_CONTRACT_ID=""

# Secret key of the address configured as `oracle_address` on each forward
# (must match NEXT_PUBLIC_ORACLE_ADDRESS in equator-frontend). The Relayer
# uses this to sign and submit settle_forward at maturity.
ORACLE_SECRET_KEY=""

# HTTP endpoint the Oracle service queries for a spot FX rate. Called as
# `${ORACLE_RATE_SOURCE_URL}` with `{PAIR}` replaced by e.g. "NGN-USD", and
# expected to respond with JSON `{ "rate": <number> }`. Leave unset to run
# without live settlement (the Relayer will log and skip matured contracts).
ORACLE_RATE_SOURCE_URL=""

# Security & Compliance Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production"
SUMSUB_APP_TOKEN="your-sumsub-token-here"
